# Optional OpenAI configuration (local fallback when Vertex AI is unavailable).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Cloud (Project 3) ---
# Required for cloud deployment on Cloud Run

# GCP project ID
GCP_PROJECT=

# Cloud Storage bucket for uploads + FAISS index persistence
GCS_BUCKET=

# BigQuery dataset for document/query analytics
BQ_DATASET=nexusdocs_analytics

# Vertex AI region and model
GCP_REGION=us-central1
VERTEX_MODEL=gemini-2.0-flash-001

# Set to "cloud" when running on Cloud Run (auto-detected via K_SERVICE)
DEPLOYMENT_ENV=local
